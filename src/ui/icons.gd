static var _cache := {}


## Textura del ícono `name` de color `color` y `size` píxeles de lado.
static func texture(name: String, color: Color, size := 48, stroke_width := 2.0) -> Texture2D:
	var key := "%s|%s|%d|%.1f" % [name, color.to_html(), size, stroke_width]
	if _cache.has(key):
		return _cache[key]
	var svg: String = SVG.get(name, SVG["heart"])
	svg = svg.replace("currentColor", "#" + color.to_html(false))
	svg = svg.replace('stroke-width="2"', 'stroke-width="%.1f"' % stroke_width)
	var image := Image.new()
	if image.load_svg_from_string(svg, size / 24.0) != OK:
		return null
	var tex := ImageTexture.create_from_image(image)
	_cache[key] = tex
	return tex
