; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="micIA"
config/description="Mini asistente / amiga con IA (Groq) y avatar."
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Settings="*res://src/core/settings.gd"
Memory="*res://src/state/memory.gd"
Mood="*res://src/state/mood.gd"
Relationship="*res://src/state/relationship.gd"
Mods="*res://src/mods/mod_loader.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=640
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
